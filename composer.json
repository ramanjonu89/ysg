{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^7.3",
        "anandsiddharth/laravel-paytm-wallet": "^1.0",
        "babenkoivan/elastic-client": "^1.2",
        "babenkoivan/elastic-migrations": "v2.0.1",
        "babenkoivan/elastic-scout-driver": "v2.0.0",
        "babenkoivan/elastic-scout-driver-plus": "v3.5.1",
        "barryvdh/laravel-dompdf": "^0.8.2",
        "darkaonline/l5-swagger": "^8.6",
        "doctrine/dbal": "^2.12.1",
        "fideloper/proxy": "^4.0",
        "gabrielbull/ups-api": "^0.8.0",
        "guzzlehttp/guzzle": "^6.5",
        "instamojo/instamojo-php": "^0.4.0",
        "intervention/image": "^2.7",
        "ixudra/curl": "^6.21",
        "kreait/laravel-firebase": "^3.0",
        "laracasts/flash": "^3.0",
        "laravel/framework": "^7.30",
        "laravel/passport": "^7.3",
        "laravel/scout": "^8.0",
        "laravel/socialite": "^4.3",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^2.0",
        "lcobucci/jwt": "3.3.3",
        "maatwebsite/excel": "^3.1",
        "nexmo/laravel": "^2.2",
        "razorpay/razorpay": "2.0.0",
        "spatie/laravel-image-optimizer": "^1.3",
        "stripe/stripe-php": "^6.29",
        "twilio/sdk": "^6.1"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.5",
        "beyondcode/laravel-dump-server": "^1.0",
        "filp/whoops": "^2.0",
        "fzaninotto/faker": "^1.4",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^4.1",
        "phpunit/phpunit": "^8.5"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/"
        },
        "files": ["app/Http/Helpers.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
            ]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
